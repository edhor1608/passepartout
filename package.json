{
  "name": "passepartout",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare-image": "bun run src/cli/prepare_image.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "biome lint src tests package.json tsconfig.json",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test:fast",
    "test": "bun test --timeout 30000",
    "test:unit": "bun test tests/*.test.ts",
    "test:fast": "bun run test:unit && bun test --timeout 30000 tests/integration/prepare_image.integration.test.ts",
    "test:ci": "bun run check",
    "test:integration": "bun test --timeout 30000 tests/integration/prepare_image.integration.test.ts",
    "test:all": "bun test --timeout 30000"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
