{
  "name": "passepartout",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-image": "bun run src/cli/prepare_image.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint --format=agent src tests",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "test": "bun test --timeout 60000",
    "test:integration": "bun test --timeout 60000 tests/integration/prepare_image.integration.test.ts"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.6"
}
