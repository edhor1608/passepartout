{
  "name": "instagram-upload-quality-lab",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "recommend": "bun run src/cli/recommend.ts",
    "analyze": "bun run src/cli/analyze.ts",
    "overlay": "bun run src/cli/overlay.ts",
    "grid-preview": "bun run src/cli/grid_preview.ts",
    "watch-folder": "bun run src/cli/watch_folder.ts",
    "validate-matrix": "bun run src/cli/validate_matrix.ts",
    "report": "bun run src/cli/report.ts",
    "report-export": "bun run src/cli/report_export.ts",
    "benchmark": "bun run src/cli/benchmark.ts",
    "export-image": "bun run src/cli/export_image.ts",
    "export-video": "bun run src/cli/export_video.ts",
    "doctor": "bun run src/cli/doctor.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test:fast",
    "test": "bun test --timeout 30000",
    "test:unit": "bun test tests/*.test.ts tests/helpers/*.test.ts",
    "test:fast": "bun run test:unit && bun test --timeout 30000 tests/integration/cli.integration.test.ts tests/integration/overlay.integration.test.ts tests/integration/grid_preview.integration.test.ts tests/integration/watch_folder.integration.test.ts",
    "test:ci": "bun run typecheck && bun run lint && bun run doctor && bun run test:fast",
    "test:slow": "bun test --timeout 30000 tests/integration/analyze.integration.test.ts tests/integration/export.integration.test.ts tests/integration/export_video.integration.test.ts tests/integration/report.integration.test.ts tests/integration/report_export.integration.test.ts tests/integration/benchmark.integration.test.ts tests/integration/validate_matrix.integration.test.ts tests/e2e tests/visual tests/property",
    "test:integration": "bun test --timeout 30000 tests/integration",
    "test:e2e": "bun test --timeout 30000 tests/e2e",
    "test:visual": "bun test tests/visual",
    "test:visual-pixel": "bun test tests/visual/pixel_diff.visual.test.ts",
    "test:property": "bun test tests/property",
    "test:all": "bun test --timeout 30000",
    "fixtures:images": "bun run tests/fixtures/images/generate-fixtures.ts",
    "fixtures:images:raster": "bun run tests/fixtures/images/generate-raster-fixtures.ts",
    "fixtures:e2e": "bun run tests/fixtures/e2e/generate-snapshots.ts",
    "fixtures:e2e:analyze": "bun run tests/fixtures/e2e/generate-analyze-snapshots.ts",
    "fixtures:e2e:report": "bun run tests/fixtures/e2e/generate-report-snapshots.ts",
    "fixtures:e2e:report-export": "bun run tests/fixtures/e2e/generate-report-export-snapshots.ts",
    "fixtures:e2e:benchmark": "bun run tests/fixtures/e2e/generate-benchmark-snapshots.ts",
    "fixtures:e2e:overlay": "bun run tests/fixtures/e2e/generate-overlay-snapshots.ts",
    "fixtures:e2e:grid-preview": "bun run tests/fixtures/e2e/generate-grid-preview-snapshots.ts",
    "fixtures:e2e:watch-folder": "bun run tests/fixtures/e2e/generate-watch-folder-snapshots.ts",
    "fixtures:e2e:validate-matrix": "bun run tests/fixtures/e2e/generate-validate-matrix-snapshots.ts",
    "fixtures:e2e:export": "bun run tests/fixtures/e2e/generate-export-snapshots.ts",
    "fixtures:e2e:export-video": "bun run tests/fixtures/e2e/generate-export-video-snapshots.ts",
    "fixtures:visual": "bun run tests/fixtures/visual/generate-snapshots.ts",
    "fixtures:pixel": "bun run tests/fixtures/pixel/generate-snapshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
